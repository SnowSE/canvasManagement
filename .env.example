# Copy to .env and fill in. Only CANVAS_TOKEN is required.

# Canvas: Account > Settings > Approved Integrations > New Access Token
CANVAS_TOKEN=paste-your-canvas-token-here

# Classroom 50 buttons, and pulling/pushing a course repo hosted on GitHub
# GH_TOKEN=ghp_...

# "Explain with AI" on the error list. Any OpenAI-compatible chat completions
# endpoint works; leave these out to turn the button off.
#
# OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
#
# OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=meta-llama/llama-3.1-70b-instruct
#
# Ollama on the host machine (no key needed; on Linux also give the compose
# service  extra_hosts: ["host.docker.internal:host-gateway"]):
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=llama3.1
